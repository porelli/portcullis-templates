 {
  "name": "multiple reasons",
  "compose": "services:\n  app:\n    image: test:latest\n    volumes:\n      - hub_data:/data\n    extra_hosts:\n      - \"host:host-gateway\"\nvolumes:\n  hub_data:\n",
  "manifest": {
   "name": "Test App",
   "auth": {"method": "forward-auth"},
   "vpn": {
    "label": "VPN",
    "ranges": ["10.0.0.0/8"],
    "ingress": {"service": "app"},
    "identity": {"source": "static"},
    "dns": {"manual": true}
   }
  },
  "env": {},
  "bind_roots": [],
  "want": {
   "primary_only": true,
   "reasons": [
    "mounts the core volume hub_data",
