 {
  "name": "has person_secret option",
  "compose": "services:\n  app:\n    image: test:latest\n",
  "manifest": {
   "name": "Test App",
   "auth": {"method": "forward-auth"},
   "settings": {
    "sections": [{"key": "general", "label": "General"}],
    "options": [
     {
      "key": "smb_password",
      "type": "person_secret",
      "section": "general",
      "label": "SMB Password",
      "scope": "person"
     }
    ]
   }
  },
  "env": {},
  "bind_roots": [],
  "want": {
   "primary_only": true,
   "reasons": ["has a per-person secret option (smb_password)"]
  }
 },
 {
  "name": "has AI companions",
  "compose": "services:\n  app:\n    image: test:latest\n  companion:\n    image: mcp-server:latest\n",
  "manifest": {
   "name": "Test App",
   "auth": {"method": "forward-auth"},
   "ai": {
    "mcp": [
     {"name": "companion", "service": "companion", "credential": {"type": "app_token"}}
    ]
   }
  },
  "env": {},
  "bind_roots": [],
  "want": {
   "primary_only": true,
   "reasons": ["has AI companions (mcp-gate reaches them on the primary)"]
  }
 },
 {
  "name": "is a VPN provider",
  "compose": "services:\n  gateway:\n    image: tailscale:latest\n",
  "manifest": {
   "name": "Test VPN",
   "auth": {"method": "forward-auth"},
   "vpn": {
    "label": "My VPN",
    "ranges": ["10.0.0.0/8"],
    "ingress": {"service": "gateway"},
    "identity": {"source": "static"},
    "dns": {"manual": true}
   }
  },
  "env": {},
  "bind_roots": [],
  "want": {
   "primary_only": true,
   "reasons": ["is a VPN provider (vpn: block)"]
  }
 },
