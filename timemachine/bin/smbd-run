#!/bin/sh
# s6 run script of smbd: the installed smb.conf must still verify
# (portcullis-sync --check, testparm against the hardened table) before
# every start or restart; otherwise smbd doesn't start (fail closed).
if ! /portcullis/bin/portcullis-sync --check; then
  sleep 5
  exit 1
fi
# Debug levels above 3 log too much detail (names, paths); anything else is 1.
case ${DEBUG_LEVEL:-1} in 0 | 1 | 2 | 3) level=${DEBUG_LEVEL:-1} ;; *) level=1 ;; esac
# --no-process-group: s6-supervise already starts this script as a session
# (and process group) leader, so smbd's own setsid() would fail ("Failed to
# create session") and its group signals never reach the supervisor (CI
# checks s6-supervise survives a stop). Under runit (Samba) runsv doesn't
# do that, so samba's smbd-run leaves the flag out instead.
exec /usr/sbin/smbd --foreground --no-process-group --debug-stdout --debuglevel="$level" < /dev/null
